---
import '../styles/global.css';
import Arbre from '../components/Arbre.astro';
import Recherche from '../components/Recherche.astro';
import { lentilleDe, reseau, url } from '../lib/site';

interface Props {
  titre: string;
  description?: string;
  /** slug du nœud de la page (surligné dans l'arbre) */
  courant?: string;
  classe?: string;
}
const { titre, description = 'Les recettes rangées en réseau : techniques, préparations de base, profils aromatiques et ingrédients.', courant, classe } = Astro.props;
const titreComplet = titre === 'Généalogie des recettes' ? titre : `${titre} — Généalogie des recettes`;
// Lentille proposée par défaut (si le visiteur n'en a pas encore choisi une).
const indice = lentilleDe(courant ? reseau().noeud(courant)?.type : undefined) ?? 'cuisson';
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titreComplet}</title>
  <meta name="description" content={description} />
  <meta name="color-scheme" content="light dark" />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <script is:inline define:vars={{ indice }}>
    var l = null;
    try { l = localStorage.getItem('recettes:lentille'); } catch (e) { l = null; }
    document.documentElement.dataset.lentille = l || indice;
    document.documentElement.classList.add('js');
  </script>
  <noscript><style>.enfants[hidden]{display:block!important}.lentille{display:block!important}.choix-lentille,.ouvrir-arbre{display:none!important}.panneau-version[hidden]{display:block!important}</style></noscript>
</head>
<body class={classe}>
  <a class="evitement" href="#contenu">Aller au contenu</a>
  <div class="page">
    <aside class="lateral" id="lateral">
      <div class="lateral-entete">
        <a class="marque" href={url('')}>Généalogie <span>des recettes</span></a>
        <button type="button" class="ouvrir-arbre" aria-expanded="false" aria-controls="lateral-corps">
          <span aria-hidden="true">☰</span> Arbre<span class="visually-hidden"> et recherche</span>
        </button>
      </div>
      <div class="lateral-corps lateral-defilant" id="lateral-corps">
        <Recherche />
        <p class="liens-outils"><a href={url('cuisiner/')}>Cuisiner avec ce que j'ai</a></p>
        <Arbre courant={courant} />
      </div>
    </aside>
    <main id="contenu" class="contenu" tabindex="-1">
      <slot />
    </main>
  </div>
  <script>
    const bouton = document.querySelector<HTMLButtonElement>('.ouvrir-arbre');
    const corps = document.getElementById('lateral-corps');
    bouton?.addEventListener('click', () => {
      const ouvrir = bouton.getAttribute('aria-expanded') !== 'true';
      bouton.setAttribute('aria-expanded', String(ouvrir));
      corps?.classList.toggle('ouvert', ouvrir);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && corps?.classList.contains('ouvert')) { bouton?.click(); bouton?.focus(); }
    });
  </script>
</body>
</html>
