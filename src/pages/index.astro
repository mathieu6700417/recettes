---
import Base from '../layouts/Base.astro';
import { drapeau, nomPays, pluriel } from '../lib/format';
import { TEINTES, arbres, reseau, titreDe, url, urlDe } from '../lib/site';

const r = reseau();
const a = arbres();
const preps = r.parType('preparation');
const bases = preps.filter((n) => n.data.nature === 'base').sort((x, y) => x.data.titre.localeCompare(y.data.titre, 'fr'));
const plats = preps.filter((n) => n.data.nature !== 'base');
const profils = r.parType('profil').filter((n) => !r.liensDe(n.slug, 'parent').length).sort((x, y) => x.data.titre.localeCompare(y.data.titre, 'fr'));
const pays = [...new Set([...preps, ...r.parType('profil')].map((n) => n.data.origine).filter(Boolean))].sort();
const nbIngredients = r.parType('ingredient').length;
const aRelire = r.parType('version').filter((v) => v.data.statut === 'a-relire').length;
---
<Base titre="Généalogie des recettes">
  <article class="accueil">
    <h1>Généalogie des recettes</h1>
    <p class="chapo">Chaque recette descend d'autres recettes : une technique de cuisson, des préparations de base,
      un profil aromatique, parfois un plat dont elle échange un ingrédient. Ici, on les range en réseau,
      pour voir ce qui change d'un lien à l'autre.</p>

    <div class="concept">
      <section>
        <h2>Des liens typés</h2>
        <ul class="types-liens">
          {(['cuisson', 'composant', 'profil', 'substitution'] as const).map((t) => (
            <li class={`t-${t}`}><span class="puce" aria-hidden="true"></span><strong>{TEINTES[t]}</strong>{' '}
              {t === 'cuisson' && 'braiser, pocher, cuire à la nappe…'}
              {t === 'composant' && 'un fond, une pâte, une crème, une liaison'}
              {t === 'profil' && 'mirepoix, bouquet garni, ras-el-hanout…'}
              {t === 'substitution' && 'le coq au vin, c’est le bourguignon au coq'}
            </li>
          ))}
        </ul>
      </section>
      <section>
        <h2>Des mutations</h2>
        <p>Chaque lien porte ce qui change par rapport au parent : <span class="fil-mutation">+ crème</span>,{' '}
          <span class="fil-mutation">fond blanc → fond brun</span>, <span class="fil-mutation">coq au lieu du bœuf</span>.</p>
      </section>
      <section>
        <h2>Des cousins</h2>
        <p>Les plats qui partagent un profil ou une mère se répondent d'un pays à l'autre.
          {pays.length > 0 && <> Origines : {pays.map((p) => <span class="drapeau" role="img" aria-label={nomPays(p)} title={nomPays(p)}>{drapeau(p)}</span>)}</>}</p>
      </section>
    </div>

    <p class="meta">
      <span>{pluriel(plats.length, 'plat')}</span>
      <span>{pluriel(bases.length, 'base')}</span>
      <span>{pluriel(r.parType('technique').length, 'technique')}</span>
      <span>{pluriel(r.parType('profil').length, 'profil')}</span>
      <span>{pluriel(nbIngredients, 'ingrédient')}</span>
    </p>

    <p class="actions-accueil">
      <a class="bouton" href={url('cuisiner/')}>Cuisiner avec ce que j'ai</a>
      {aRelire > 0 && <a class="bouton" href={url('a-relire/')}>{aRelire} version{aRelire > 1 ? 's' : ''} à relire</a>}
    </p>

    <section aria-labelledby="titre-cuisson">
      <h2 id="titre-cuisson">Techniques de cuisson</h2>
      <ul class="cartes">
        {a.racines.cuisson.filter((b) => b.type === 'technique').map((b) => (
          <li class="carte">
            <a href={b.url}>
              <span class="carte-titre">{b.titre}</span>
              <span class="carte-resume">{r.noeud(b.cle)?.data.resume}</span>
              <span class="carte-compte">{pluriel(b.compte, 'préparation')}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {bases.length > 0 && (
      <section aria-labelledby="titre-bases">
        <h2 id="titre-bases">Préparations de base</h2>
        <p class="liens-en-ligne">{bases.map((n, i) => <>{i > 0 && ' · '}<a href={urlDe(n.slug)}>{n.data.titre}</a></>)}</p>
      </section>
    )}
    {profils.length > 0 && (
      <section aria-labelledby="titre-profils">
        <h2 id="titre-profils">Profils aromatiques</h2>
        <p class="liens-en-ligne">{profils.map((n, i) => <>{i > 0 && ' · '}<a href={urlDe(n.slug)}>{n.data.origine && <span class="drapeau" aria-hidden="true">{drapeau(n.data.origine)} </span>}{titreDe(n.slug)}</a></>)}</p>
      </section>
    )}
  </article>
</Base>
