---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import GrapheLocal from '../../components/GrapheLocal.astro';
import Ref from '../../components/Ref.astro';
import { ascendance, descendantsDe, enfantsDe, parentDe, reseau, titreDe } from '../../lib/site';

export function getStaticPaths() {
  return reseau().parType('technique').map((n) => ({ params: { slug: n.slug } }));
}

const { slug } = Astro.params as { slug: string };
const r = reseau();
const d = r.noeud(slug)!.data;
const entree = await getEntry('techniques', slug);
const Corps = entree?.body?.trim() ? (await render(entree)).Content : null;
const chaine = ascendance(slug);
const parent = parentDe(slug);
const sous = enfantsDe(slug);

const parTitre = (a: { de: string }, b: { de: string }) => titreDe(a.de).localeCompare(titreDe(b.de), 'fr');
const directes = r.liensVers(slug, 'cuisson').filter((l) => r.noeud(l.de)).sort(parTitre);
const via = descendantsDe(slug)
  .map((t) => ({ t, liens: r.liensVers(t, 'cuisson').filter((l) => r.noeud(l.de)).sort(parTitre) }))
  .filter((x) => x.liens.length);
const accords = r.liensVers(slug, 'accord').map((l) => l.de).filter((s) => r.noeud(s))
  .sort((a, b) => titreDe(a).localeCompare(titreDe(b), 'fr'));
const total = new Set([...directes, ...via.flatMap((x) => x.liens)].map((l) => l.de)).size;
---
<Base titre={d.titre} courant={slug} description={d.resume}>
  <article class="fiche fiche-technique">
    <header class="fiche-entete">
      <nav class="ariane" aria-label="Ascendance">
        <span class="type-noeud">Technique</span>
        {chaine.map((s) => <><Ref slug={s} /><span class="fleche" aria-hidden="true"> → </span></>)}
        <span aria-current="page">{d.titre}</span>
      </nav>
      <h1>{d.titre}</h1>
      <p class="resume">{d.resume}</p>
      <p class="meta">
        <span>{sous.length} sous-technique{sous.length > 1 ? 's' : ''}</span>
        <span>{total} préparation{total > 1 ? 's' : ''}</span>
      </p>
    </header>

    {parent && (
      <section class="haut" aria-label="Parent">
        <div class="groupe-liens t-parent">
          <h3 class="titre-groupe"><span class="puce" aria-hidden="true"></span>Descend de</h3>
          <ul class="liens"><li><Ref slug={parent.vers} />{parent.mutation && <span class="fil-mutation">{parent.mutation}</span>}</li></ul>
        </div>
      </section>
    )}

    <GrapheLocal slug={slug} />

    <div class="milieu">
      {Corps && <div class="prose principe"><Corps /></div>}
    </div>

    <section class="bas" aria-labelledby="titre-descendants">
      <h2 id="titre-descendants">Descendance</h2>
      {sous.length > 0 && (
        <div class="groupe-liens t-parent">
          <h3 class="titre-groupe"><span class="puce" aria-hidden="true"></span>Sous-techniques</h3>
          <ul class="liens">
            {sous.map((s) => (<li><Ref slug={s} />{parentDe(s)?.mutation && <span class="fil-mutation">{parentDe(s)?.mutation}</span>}</li>))}
          </ul>
        </div>
      )}
      <div class="groupe-liens t-cuisson">
        <h3 class="titre-groupe"><span class="puce" aria-hidden="true"></span>Préparations qui l'utilisent</h3>
        {directes.length > 0 ? (
          <ul class="liens">
            {directes.map((l) => (<li><Ref slug={l.de} />{l.rang > 0 && <span class="note"> (cuisson secondaire)</span>}{l.mutation && <span class="fil-mutation">{l.mutation}</span>}</li>))}
          </ul>
        ) : <p class="vide">Aucune préparation directement.</p>}
      </div>
      {via.map(({ t, liens }) => (
        <div class="groupe-liens t-cuisson via">
          <h3 class="titre-groupe"><span class="puce" aria-hidden="true"></span>Via <Ref slug={t} /></h3>
          <ul class="liens">
            {liens.map((l) => (<li><Ref slug={l.de} />{l.rang > 0 && <span class="note"> (cuisson secondaire)</span>}{l.mutation && <span class="fil-mutation">{l.mutation}</span>}</li>))}
          </ul>
        </div>
      ))}
      {accords.length > 0 && (
        <div class="groupe-liens t-accord">
          <h3 class="titre-groupe"><span class="puce" aria-hidden="true"></span>Ingrédients qui s'y prêtent</h3>
          <p class="liens-en-ligne">{accords.map((s, i) => <>{i > 0 && ' · '}<Ref slug={s} /></>)}</p>
        </div>
      )}
    </section>
  </article>
</Base>
