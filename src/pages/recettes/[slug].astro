---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  DIFFICULTES, ascendanceTechnique, drapeau, duree, genealogie, nomPays, urlRecette, urlTechnique,
  type Recette,
} from '../../lib/arbre';
import { liaison, majuscule, texteQuantite } from '../../lib/quantites';

export async function getStaticPaths() {
  const g = await genealogie();
  return [...g.recettes.values()].map((r) => ({ params: { slug: r.id }, props: { recette: r } }));
}

interface Props { recette: Recette }
const { recette } = Astro.props;
const d = recette.data;
const g = await genealogie();
const { Content } = await render(recette);

const fils = [
  { nom: 'Mode de cuisson', lien: d.cuisson_technique },
  { nom: 'Préparation de base', lien: d.bases[0] },
].map(({ nom, lien }) => ({
  nom,
  mutation: lien.mutation,
  chaine: g.techniques.has(lien.slug) ? ascendanceTechnique(g, lien.slug) : [],
  manquant: g.techniques.has(lien.slug) ? null : lien.slug,
}));
const basesSecondaires = d.bases.slice(1).map((b) => ({ ...b, technique: g.techniques.get(b.slug) }));
const mere = d.variante_de ? { ...d.variante_de, recette: g.recettes.get(d.variante_de.slug) } : null;
const filles = [...g.recettes.values()]
  .filter((r) => r.data.variante_de?.slug === recette.id && r.id !== recette.id)
  .sort((a, b) => a.data.titre.localeCompare(b.data.titre, 'fr'));

// Ingrédients groupés par `groupe`, dans l'ordre d'apparition.
const groupes: { nom: string | null; items: typeof d.ingredients }[] = [];
for (const ing of d.ingredients) {
  const nom = ing.groupe ?? null;
  let gr = groupes.find((x) => x.nom === nom);
  if (!gr) { gr = { nom, items: [] }; groupes.push(gr); }
  gr.items.push(ing);
}
const pluriel = (n: number) => `${n} personne${n > 1 ? 's' : ''}`;
---
<Base titre={d.titre} courant={`recette:${recette.id}`} description={`${d.titre} : ingrédients, étapes et généalogie de la recette.`}>
  <article class="recette" data-portions={d.portions}>
    <header class="entete-recette">
      <h1>{d.titre} <span class="drapeau" role="img" aria-label={nomPays(d.origine)} title={nomPays(d.origine)}>{drapeau(d.origine)}</span></h1>
      <p class="meta">
        <span class="nb-portions">{pluriel(d.portions)}</span>
        {d.preparation > 0 && <span>Préparation {duree(d.preparation)}</span>}
        {d.cuisson > 0 && <span>Cuisson {duree(d.cuisson)}</span>}
        <span>{DIFFICULTES[d.difficulte]}</span>
        <span class="ecran-seul">{nomPays(d.origine)}</span>
      </p>

      <div class="genealogie">
        {fils.map((f) => (
          <p class="fil">
            <span class="fil-axe">{f.nom}</span>
            <span class="fil-chaine">
              {f.chaine.map((t, i) => (<>{i > 0 && <span class="fleche" aria-hidden="true"> → </span>}<a href={urlTechnique(t.id)}>{t.data.titre}</a></>))}
              {f.manquant && <span class="manquant">{f.manquant}</span>}
              <span class="fleche" aria-hidden="true"> → </span><span class="fil-mutation">{f.mutation}</span>
            </span>
          </p>
        ))}
        {basesSecondaires.length > 0 && (
          <p class="fil">
            <span class="fil-axe">Utilise aussi</span>
            <span class="fil-chaine">
              {basesSecondaires.map((b, i) => (
                <>{i > 0 && ' · '}{b.technique ? <a href={urlTechnique(b.slug)}>{b.technique.data.titre}</a> : <span class="manquant">{b.slug}</span>}{' '}<span class="fil-mutation">({b.mutation})</span></>
              ))}
            </span>
          </p>
        )}
        {mere && (
          <p class="fil">
            <span class="fil-axe">Variante de</span>
            <span class="fil-chaine">
              {mere.recette ? <a href={urlRecette(mere.slug)}>{mere.recette.data.titre}</a> : <span class="manquant">{mere.slug}</span>}
              <span class="fleche" aria-hidden="true"> → </span><span class="fil-mutation">{mere.mutation}</span>
            </span>
          </p>
        )}
        {filles.length > 0 && (
          <p class="fil">
            <span class="fil-axe">Variantes</span>
            <span class="fil-chaine">
              {filles.map((f, i) => (
                <>{i > 0 && ' · '}<a href={urlRecette(f.id)}>{f.data.titre}</a> <span class="fil-mutation">({f.data.variante_de!.mutation})</span></>
              ))}
            </span>
          </p>
        )}
      </div>

      <div class="outils" role="toolbar" aria-label="Outils de la recette">
        <div class="portions" role="group" aria-label="Nombre de personnes">
          <button type="button" class="moins" aria-label="Une personne de moins">−</button>
          <output class="valeur" aria-live="polite">{d.portions}</output>
          <span class="unite-portions">{d.portions > 1 ? 'personnes' : 'personne'}</span>
          <button type="button" class="plus" aria-label="Une personne de plus">+</button>
        </div>
        <button type="button" class="bouton entrer-cuisine">Mode cuisine</button>
        <button type="button" class="bouton imprimer">Imprimer</button>
      </div>
    </header>

    <div class="grille">
      <section class="ingredients" aria-labelledby="titre-ingredients">
        <h2 id="titre-ingredients">Ingrédients</h2>
        {groupes.map((gr) => (
          <>
            {gr.nom && <h3>{gr.nom}</h3>}
            <ul>
              {gr.items.map((ing) => (
                <li>
                  <label>
                    <input type="checkbox" class="coche" />
                    <span class="texte">
                      {ing.qte === null
                        ? majuscule(ing.unite ? `${ing.unite} ${liaison(ing.nom)}${ing.nom}` : ing.nom)
                        : (<><span class="q" data-qte={ing.qte} data-unite={ing.unite}>{texteQuantite(ing.qte, ing.unite)}</span>{ing.unite ? ` ${liaison(ing.nom)}` : ' '}{ing.nom}</>)}
                    </span>
                  </label>
                </li>
              ))}
            </ul>
          </>
        ))}
      </section>

      <section class="etapes" aria-labelledby="titre-etapes">
        <h2 id="titre-etapes">Préparation</h2>
        <ol>
          {d.etapes.map((e) => (
            <li><label><input type="checkbox" class="coche" /><span class="texte">{e}</span></label></li>
          ))}
        </ol>
      </section>
    </div>

    {recette.body?.trim() && (
      <section class="notes prose" aria-labelledby="titre-notes">
        <h2 id="titre-notes">Notes</h2>
        <Content />
      </section>
    )}

    {d.source && <p class="source">Source : {d.source}</p>}
  </article>

  <button type="button" class="bouton sortir-cuisine">Quitter le mode cuisine</button>
</Base>

<script>
  import { texteQuantite } from '../../lib/quantites';

  const article = document.querySelector<HTMLElement>('.recette');
  if (article) {
    const base = Number(article.dataset.portions);
    let portions = base;
    const valeur = article.querySelector<HTMLOutputElement>('.portions .valeur')!;
    const unite = article.querySelector<HTMLElement>('.unite-portions')!;
    const meta = article.querySelector<HTMLElement>('.nb-portions')!;
    const moins = article.querySelector<HTMLButtonElement>('.moins')!;

    const maj = () => {
      const f = portions / base;
      valeur.textContent = String(portions);
      unite.textContent = portions > 1 ? 'personnes' : 'personne';
      meta.textContent = `${portions} personne${portions > 1 ? 's' : ''}`;
      moins.disabled = portions <= 1;
      article.querySelectorAll<HTMLElement>('.q').forEach((q) => {
        q.textContent = texteQuantite(Number(q.dataset.qte), q.dataset.unite ?? '', f);
      });
    };
    moins.addEventListener('click', () => { if (portions > 1) { portions--; maj(); } });
    article.querySelector('.plus')!.addEventListener('click', () => { portions++; maj(); });
    maj();

    article.querySelector('.imprimer')!.addEventListener('click', () => window.print());

    // Mode cuisine
    let verrou: WakeLockSentinel | null = null;
    const acquerir = async () => {
      if (!('wakeLock' in navigator) || !document.body.classList.contains('cuisine')) return;
      try { verrou = await navigator.wakeLock.request('screen'); } catch { verrou = null; }
    };
    const relacher = async () => {
      try { await verrou?.release(); } catch { /* déjà relâché */ }
      verrou = null;
    };
    const entrer = article.querySelector<HTMLButtonElement>('.entrer-cuisine')!;
    const sortir = document.querySelector<HTMLButtonElement>('.sortir-cuisine')!;
    entrer.addEventListener('click', () => {
      document.body.classList.add('cuisine');
      acquerir();
      sortir.focus();
    });
    sortir.addEventListener('click', () => {
      document.body.classList.remove('cuisine');
      relacher();
      entrer.focus();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && document.body.classList.contains('cuisine') && !(e.target instanceof HTMLInputElement && e.target.type === 'search')) sortir.click();
    });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') acquerir();
    });
  }
</script>
