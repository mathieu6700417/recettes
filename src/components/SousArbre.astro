---
import type { Noeud } from '../lib/arbre';
import { drapeau, nomPays, urlNoeud } from '../lib/arbre';
interface Props { noeuds: Noeud[] }
const { noeuds } = Astro.props;
---
<ul class="sous-arbre">
  {noeuds.map((n) => (
    <li class={`sa-${n.type}`}>
      <a href={urlNoeud(n)}>
        {n.type === 'recette' && n.origine && <span class="drapeau" role="img" aria-label={nomPays(n.origine)}>{drapeau(n.origine)}</span>}
        {n.titre}
      </a>
      {n.mutation && <span class="sa-mutation">{n.mutation}</span>}
      {n.enfants.length > 0 && <Astro.self noeuds={n.enfants} />}
    </li>
  ))}
</ul>
