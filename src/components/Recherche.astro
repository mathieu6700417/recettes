---
import { url } from '../lib/site';
---
<div class="recherche" data-index={url('recherche.json')}>
  <label for="champ-recherche" class="visually-hidden">Rechercher une préparation, un ingrédient, une technique ou un profil</label>
  <input id="champ-recherche" type="search" placeholder="Plat, ingrédient, technique…" autocomplete="off"
    role="combobox" aria-expanded="false" aria-controls="resultats-recherche" aria-autocomplete="list" />
  <ul id="resultats-recherche" class="resultats" role="listbox" aria-label="Résultats" hidden></ul>
  <p class="visually-hidden" aria-live="polite" id="statut-recherche"></p>
</div>

<script>
  import { normaliser } from '../lib/format';

  interface Prep { titre: string; url: string; drapeau: string }
  type Entree =
    | ({ t: 'preparation'; nature: string; resume: string; ingredients: string[] } & Prep)
    | { t: 'technique'; titre: string; url: string; resume: string }
    | { t: 'profil'; titre: string; url: string; drapeau: string; resume: string }
    | { t: 'ingredient' | 'famille'; titre: string; url: string; synonymes: string[]; chaine: string; preparations: Prep[] };

  const MAX = 8;
  const racine = document.querySelector<HTMLElement>('.recherche')!;
  const champ = racine.querySelector<HTMLInputElement>('input')!;
  const liste = racine.querySelector<HTMLUListElement>('.resultats')!;
  const statut = racine.querySelector<HTMLElement>('#statut-recherche')!;
  let index: Entree[] | null = null;
  let chargement: Promise<void> | null = null;
  let actif = -1;

  function charger() {
    chargement ??= fetch(racine.dataset.index!)
      .then((r) => r.json())
      .then((d: Entree[]) => { index = d; })
      .catch(() => { index = []; });
    return chargement;
  }

  const echapper = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

  /** Met en évidence la requête (insensible aux accents) dans le texte d'origine. */
  function surligner(texte: string, q: string) {
    const carte: number[] = [];
    let norm = '';
    for (let i = 0; i < texte.length; i++) {
      const n = normaliser(texte[i]);
      for (let k = 0; k < n.length; k++) { norm += n[k]; carte.push(i); }
    }
    const p = norm.indexOf(q);
    if (p < 0) return echapper(texte);
    const debut = carte[p];
    const fin = carte[p + q.length - 1] + 1;
    return `${echapper(texte.slice(0, debut))}<mark>${echapper(texte.slice(debut, fin))}</mark>${echapper(texte.slice(fin))}`;
  }

  function fermer() {
    liste.hidden = true;
    champ.setAttribute('aria-expanded', 'false');
    champ.removeAttribute('aria-activedescendant');
    actif = -1;
  }

  function activer(i: number) {
    const options = liste.querySelectorAll<HTMLElement>('[role="option"]');
    if (!options.length) return;
    actif = (i + options.length) % options.length;
    options.forEach((o, k) => o.setAttribute('aria-selected', String(k === actif)));
    champ.setAttribute('aria-activedescendant', options[actif].id);
    options[actif].scrollIntoView({ block: 'nearest' });
  }

  let n = 0;
  const option = (href: string, contenu: string, classe = '') =>
    `<li role="option" id="res-${n++}" aria-selected="false" class="${classe}"><a href="${href}" tabindex="-1">${contenu}</a></li>`;
  const detail = (s: string) => (s ? `<span class="detail">${s}</span>` : '');
  const drap = (d: string) => (d ? `<span class="drapeau" aria-hidden="true">${d}</span> ` : '');

  async function chercher() {
    const q = normaliser(champ.value.trim());
    if (q.length < 2) { fermer(); liste.innerHTML = ''; statut.textContent = ''; return; }
    await charger();
    if (normaliser(champ.value.trim()) !== q) return;
    n = 0;
    const groupes: Record<string, string[]> = { preparation: [], ingredient: [], technique: [], profil: [] };
    const compte: Record<string, number> = { preparation: 0, ingredient: 0, technique: 0, profil: 0 };
    const preps: { e: Entree & { t: 'preparation' }; ings: string[]; titre: boolean }[] = [];
    for (const e of index ?? []) {
      if (e.t === 'preparation') {
        const titre = normaliser(e.titre).includes(q);
        const ings = e.ingredients.filter((i) => normaliser(i).includes(q));
        if (titre || ings.length) preps.push({ e, ings, titre });
      } else if (e.t === 'ingredient' || e.t === 'famille') {
        const syn = e.synonymes.filter((s) => normaliser(s).includes(q));
        if (!normaliser(e.titre).includes(q) && !syn.length) continue;
        if (++compte.ingredient > MAX) continue;
        const nom = syn.length && !normaliser(e.titre).includes(q)
          ? `${echapper(e.titre)} <span class="synonyme">(${surligner(syn[0], q)})</span>`
          : surligner(e.titre, q);
        groupes.ingredient.push(option(e.url, `<span>${nom}</span>${detail(echapper(e.chaine))}`));
        for (const p of e.preparations.slice(0, 4)) {
          groupes.ingredient.push(option(p.url, `<span class="via">↳</span> ${drap(p.drapeau)}${echapper(p.titre)}`, 'sous-resultat'));
        }
        if (e.preparations.length > 4) {
          groupes.ingredient.push(option(e.url, `<span class="via">↳</span> et ${e.preparations.length - 4} autre${e.preparations.length - 4 > 1 ? 's' : ''}…`, 'sous-resultat'));
        }
      } else if (normaliser(e.titre).includes(q)) {
        if (++compte[e.t] > MAX) continue;
        groupes[e.t].push(option(e.url, `${e.t === 'profil' ? drap(e.drapeau) : ''}<span>${surligner(e.titre, q)}</span>${detail(echapper(e.resume))}`));
      }
    }
    // Les préparations dont le titre correspond passent avant celles trouvées par un ingrédient.
    preps.sort((a, b) => Number(b.titre) - Number(a.titre));
    for (const { e, ings } of preps) {
      if (++compte.preparation > MAX) continue;
      groupes.preparation.push(option(e.url, `${drap(e.drapeau)}<span>${surligner(e.titre, q)}</span>${detail(ings.slice(0, 2).map((i) => surligner(i, q)).join(' · '))}`));
    }
    const NOMS: Record<string, string> = { preparation: 'Préparations', ingredient: 'Ingrédients', technique: 'Techniques', profil: 'Profils' };
    let html = '';
    for (const [t, items] of Object.entries(groupes)) {
      if (items.length) html += `<li class="groupe" role="presentation">${NOMS[t]}</li>${items.join('')}`;
    }
    if (!html) html = '<li class="vide" role="presentation">Aucun résultat</li>';
    liste.innerHTML = html;
    liste.hidden = false;
    champ.setAttribute('aria-expanded', 'true');
    actif = -1;
    statut.textContent = Object.entries(compte).filter(([, c]) => c).map(([t, c]) => `${c} ${NOMS[t].toLowerCase()}`).join(', ') || 'Aucun résultat';
  }

  champ.addEventListener('focus', () => { charger(); if (liste.innerHTML && champ.value.trim().length >= 2) { liste.hidden = false; champ.setAttribute('aria-expanded', 'true'); } });
  champ.addEventListener('input', chercher);
  champ.addEventListener('keydown', (ev) => {
    if (ev.key === 'ArrowDown') { ev.preventDefault(); if (liste.hidden) chercher(); else activer(actif + 1); }
    else if (ev.key === 'ArrowUp') { ev.preventDefault(); activer(actif - 1); }
    else if (ev.key === 'Enter') {
      const options = liste.querySelectorAll<HTMLElement>('[role="option"] a');
      const cible = options[actif >= 0 ? actif : 0];
      if (cible && !liste.hidden) { ev.preventDefault(); window.location.href = cible.getAttribute('href')!; }
    } else if (ev.key === 'Escape') { if (!liste.hidden) { ev.preventDefault(); ev.stopPropagation(); fermer(); } else champ.value = ''; }
  });
  liste.addEventListener('mousedown', (ev) => ev.preventDefault());
  champ.addEventListener('blur', () => setTimeout(fermer, 100));
  document.addEventListener('keydown', (ev) => {
    if (ev.key === '/' && !(ev.target instanceof HTMLInputElement || ev.target instanceof HTMLTextAreaElement)) {
      ev.preventDefault();
      champ.focus();
    }
  });
</script>
