---
import type { Axe, Noeud } from '../lib/arbre';
import { drapeau, nomPays, urlNoeud } from '../lib/arbre';

interface Props {
  noeud: Noeud;
  axe: Axe;
  ouverts: Set<string>;
  courant?: string;
  racine?: boolean;
}
const { noeud, axe, ouverts, courant, racine = false } = Astro.props;
const cle = `${noeud.type}:${noeud.slug}`;
const id = `n-${axe}-${noeud.type}-${noeud.slug}`;
const ouvert = ouverts.has(cle);
const estCourant = courant === cle;
const aEnfants = noeud.enfants.length > 0;
---
<li class:list={['noeud', `noeud-${noeud.type}`, { courant: estCourant }]} data-cle={cle}>
  <div class="ligne">
    {aEnfants ? (
      <button type="button" class="deplier" aria-expanded={ouvert ? 'true' : 'false'} aria-controls={id}
        data-id={`${axe}:${cle}`}>
        <span class="visually-hidden">{ouvert ? 'Replier' : 'Déplier'} {noeud.titre}</span>
      </button>
    ) : <span class="deplier-vide" aria-hidden="true"></span>}
    <a href={urlNoeud(noeud)} aria-current={estCourant ? 'page' : undefined}>
      {noeud.type === 'recette' && noeud.origine && (
        <span class="drapeau" role="img" aria-label={nomPays(noeud.origine)}>{drapeau(noeud.origine)}</span>
      )}
      <span class="titre">{noeud.titre}</span>
      {noeud.type === 'technique' && noeud.nbRecettes > 0 && (
        <span class="compteur" title={`${noeud.nbRecettes} recette${noeud.nbRecettes > 1 ? 's' : ''}`}>{noeud.nbRecettes}</span>
      )}
    </a>
  </div>
  {!racine && noeud.mutation && <div class="mutation">{noeud.mutation}</div>}
  {aEnfants && (
    <ul id={id} class="enfants" hidden={!ouvert}>
      {noeud.enfants.map((e) => <Astro.self noeud={e} axe={axe} ouverts={ouverts} courant={courant} />)}
    </ul>
  )}
</li>
