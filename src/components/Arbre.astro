---
import { LENTILLES, NOMS_LENTILLES, aDeplier, arbres } from '../lib/site';
import NoeudArbre from './NoeudArbre.astro';

interface Props {
  /** slug du nœud de la page courante */
  courant?: string;
}
const { courant } = Astro.props;
const a = arbres();
const ouverts = aDeplier(courant);
---
<nav class="arbre" aria-label="Arbre du réseau">
  <div class="choix-lentille" role="group" aria-label="Lentille de l'arbre">
    {LENTILLES.map((l) => (
      <button type="button" class="bascule" data-lentille={l} aria-pressed="false">{NOMS_LENTILLES[l]}</button>
    ))}
  </div>
  {LENTILLES.map((l) => (
    <div class="lentille" data-lentille={l}>
      <h2 class="visually-hidden">Lentille {NOMS_LENTILLES[l].toLowerCase()}</h2>
      <ul class="racines">
        {a.racines[l].map((b) => (
          <NoeudArbre branche={b} lentille={l} ouverts={ouverts[l]} courant={courant} racine />
        ))}
      </ul>
    </div>
  ))}
</nav>

<script>
  const CLE_LENTILLE = 'recettes:lentille';
  const CLE_OUVERTS = 'recettes:ouverts-v2';
  const lire = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const ecrire = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* stockage indisponible */ } };

  function choisir(l: string, memoriser = true) {
    document.documentElement.dataset.lentille = l;
    document.querySelectorAll<HTMLButtonElement>('.choix-lentille .bascule').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.lentille === l));
    });
    if (memoriser) ecrire(CLE_LENTILLE, l);
  }
  choisir(document.documentElement.dataset.lentille || 'cuisson', false);
  document.querySelectorAll<HTMLButtonElement>('.choix-lentille .bascule').forEach((b) => {
    b.addEventListener('click', () => { choisir(b.dataset.lentille!); montrerCourant(); });
  });

  let memo: string[] = [];
  try { memo = JSON.parse(lire(CLE_OUVERTS) || '[]'); } catch { memo = []; }
  const ensemble = new Set(Array.isArray(memo) ? memo : []);

  function basculer(btn: HTMLButtonElement, ouvrir: boolean) {
    const cible = document.getElementById(btn.getAttribute('aria-controls')!);
    if (!cible) return;
    btn.setAttribute('aria-expanded', String(ouvrir));
    cible.hidden = !ouvrir;
    const libelle = btn.querySelector('.visually-hidden');
    if (libelle) libelle.textContent = libelle.textContent!.replace(/^(Replier|Déplier)/, ouvrir ? 'Replier' : 'Déplier');
  }

  document.querySelectorAll<HTMLButtonElement>('.arbre .deplier').forEach((btn) => {
    const id = btn.dataset.id!;
    if (ensemble.has(id)) basculer(btn, true);
    if (btn.getAttribute('aria-expanded') === 'true') ensemble.add(id);
    btn.addEventListener('click', () => {
      const ouvrir = btn.getAttribute('aria-expanded') !== 'true';
      basculer(btn, ouvrir);
      if (ouvrir) ensemble.add(id); else ensemble.delete(id);
      ecrire(CLE_OUVERTS, JSON.stringify([...ensemble]));
    });
  });
  ecrire(CLE_OUVERTS, JSON.stringify([...ensemble]));

  // Faire apparaître le nœud courant dans la zone visible de la barre latérale.
  function montrerCourant() {
    const lateral = document.querySelector<HTMLElement>('.lateral-defilant');
    const courant = document.querySelector<HTMLElement>(`.lentille[data-lentille="${document.documentElement.dataset.lentille}"] .noeud.courant > .ligne`);
    if (!lateral || !courant || lateral.scrollHeight <= lateral.clientHeight) return;
    const r = courant.getBoundingClientRect();
    const rl = lateral.getBoundingClientRect();
    if (r.bottom > rl.bottom || r.top < rl.top) lateral.scrollTop += r.top - rl.top - rl.height / 2;
  }
  montrerCourant();
</script>
